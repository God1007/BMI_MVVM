    <!-- 具体建议 -->
    <!-- 体重过轻 -->
    <string name="underweight_child_male">增加富含营养的食物，并咨询儿科医生。</string>
    <string name="underweight_child_female">保持均衡饮食并定期监测成长。</string>
    <string name="underweight_adult_male">增加蛋白质摄入并结合力量训练。</string>
    <string name="underweight_adult_female">多摄入营养密度高的食物并适度运动。</string>

    <!-- 正常体重 -->
    <string name="normal_child_male">保持均衡饮食和规律运动。</string>
    <string name="normal_child_female">继续保持良好的饮食和活动习惯。</string>
    <string name="normal_adult_male">维持当前生活方式并定期锻炼。</string>
    <string name="normal_adult_female">保持良好状态，继续均衡饮食。</string>

    <!-- 超重 -->
    <string name="overweight_child_male">多参加运动并注意健康饮食。</string>
    <string name="overweight_child_female">控制食量并增加户外活动。</string>
    <string name="overweight_adult_male">减少热量摄入并增加有氧运动。</string>
    <string name="overweight_adult_female">控制饮食并保持规律运动。</string>

    <!-- 肥胖 -->
    <string name="obese_child_male">请咨询儿科医生制定体重管理计划。</string>
    <string name="obese_child_female">请寻求医生帮助制定儿童减重方案。</string>
    <string name="obese_adult_male">请咨询医生制定综合健康计划。</string>
    <string name="obese_adult_female">请寻求医疗建议以制定可持续的减重计划。</string>

    <!-- 严重体重问题 -->
    <string name="severely_underweight_child">请立即咨询儿科医生获取营养指导。</string>
    <string name="severely_underweight_adult">请立即就医并调整饮食结构。</string>
